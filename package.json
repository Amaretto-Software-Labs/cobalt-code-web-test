{
  "name": "cobalt-notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:check && next dev",
    "build": "next build",
    "start": "npm run db:check && next start",
    "preview": "npm run db:migrate && npm run build && npm run db:check && next start --hostname 0.0.0.0 --port 3000",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/check-schema.mjs",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/postgres.integration.test.ts tests/notes-routes.integration.test.ts --maxWorkers=1",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swagger-ui-react": "^5.32.12"
  },
  "overrides": {
    "swagger-ui-react": {
      "js-yaml": "4.3.1"
    }
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
